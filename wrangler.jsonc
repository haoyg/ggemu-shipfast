{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggemu-shipfast",
  "keep_vars": true,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "pokopie.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pokopie.com",
      "custom_domain": true
    }
  ]
}
